# Dockerfile.prod - 生产环境镜像
#
# 与 Dockerfile (开发/staging) 的差异:
# 1. CMD 使用 --workers 4 (与 start.sh start_prod 一致, 第 118 行)
#    开发用单进程 --reload, 生产用多 worker 提升并发能力
# 2. 不设 HEALTHCHECK (避免 worker 容器健康检查失败)
#    docker-compose.prod.yml 的 api 服务已配置 healthcheck (第 33-38 行)
#    worker 服务运行 celery, 无 HTTP 端口, 若继承 HEALTHCHECK (curl :8000) 会误判失败
#    故 HEALTHCHECK 交由 docker-compose 按服务分别配置

FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# 1. 最小化系统依赖 (仅保留生产必需)
# curl 用于 docker-compose.prod.yml api 服务的健康检查
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 2. 复制依赖清单 (先复制利用缓存)
COPY requirements.txt ./

# 3. 安装生产依赖 (仅 requirements.txt 中的运行时依赖)
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# 4. 复制应用代码 (.dockerignore 已排除敏感文件)
COPY src/ ./src/
COPY apps/ ./apps/
COPY config/ ./config/
COPY pyproject.toml ./

# 5. 创建非 root 用户并设置权限
RUN groupadd -r testai && useradd -r -g testai testai \
    && chown -R testai:testai /app

USER testai

EXPOSE 8000

# 6. 启动命令: uvicorn 多 worker (与 start.sh start_prod 一致)
#    docker-compose.prod.yml 的 worker 服务会用 command 覆盖此 CMD (celery worker)
#    docker-compose.prod.yml 的 api 服务继承此 CMD
CMD ["uvicorn", "src.platform.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
